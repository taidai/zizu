# ============================================================
# ZiZu 环境变量模板
#
# 用法:
#   本地开发:    python scripts/bootstrap_runtime_secrets.py
#   e606 部署:  cp .env.e606 .env
# ============================================================

# ---- 应用基础 ----
APP_NAME=ZiZu
APP_PORT=9000
# 机器验收从公开 HTTP 边界回访本实例；留空时使用 http://127.0.0.1:${APP_PORT}。
PUBLIC_API_BASE_URL=
LOG_LEVEL=INFO
DEBUG=false
# 部署默认强制安全。只有完全隔离的本机开发可同时设置：
# DEPLOYMENT_MODE=development 与 ALLOW_INSECURE_DEV_SECRETS=true
# 启用后进程会在 stderr 显示醒目的不安全警示；禁止用于可访问的部署。
DEPLOYMENT_MODE=production
ALLOW_INSECURE_DEV_SECRETS=false
# 独立匿名开关；只允许 development，启用后服务端响应和前端均持续警示。
ALLOW_INSECURE_ANONYMOUS_ACCESS=false

# ---- TimescaleDB / PostgreSQL ---
DB_HOST=timescaledb        # Docker Compose 内部服务名; e606 改为 127.0.0.1
DB_PORT=5432
DB_OWNER_USER=zizu_owner
DB_OWNER_PASSWORD=
# Only the controlled host-side owner migration job uses these overrides.
# Leave blank for the default DB_HOST/DB_PORT; Docker Compose hosts normally
# use DB_OWNER_HOST=127.0.0.1 because `timescaledb` is an internal DNS name.
DB_OWNER_HOST=
DB_OWNER_PORT=
# 后端仅使用这个非 owner 应用账号；不要填 PostgreSQL schema owner。
DB_USER=zizu_app
DB_PASSWORD=
DB_NAME=zizu_iot
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---- MQTT (nanoMQ) ---
MQTT_HOST=nanomq            # Docker Compose 内部; e606 改为 127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=zizu-backend
MQTT_QOS=1
# 支持逗号分隔的多 topic; Neuron 默认北向 topic 常为 /neuron/MQTT (注意前导斜杠)
MQTT_TELEMETRY_TOPIC=/neuron/#  # 支持逗号分隔与 +/# 通配符，覆盖所有 Neuron 北向主题
MQTT_KEEPALIVE=60
MQTT_RECONNECT_DELAY=5.0

# ---- Neuron (设备网关) ---
NEURON_API_URL=http://neuron:7000   # Docker 内部; e606 改为 http://127.0.0.1:7000
NEURON_API_VERSION=/api/v2
NEURON_USERNAME=admin
NEURON_PASSWORD=

# ---- nanoMQ REST API ----
NANOMQ_API_URL=http://nanomq:8081   # Docker 内部; e606 改为 http://127.0.0.1:8081
NANOMQ_API_USERNAME=admin
# 运行 python scripts/bootstrap_runtime_secrets.py 生成，禁止使用 NanoMQ 默认值
NANOMQ_API_PASSWORD=
NANOMQ_CONF_PATH=./config/nanomq.conf   # 后端容器内映射为 /app/config/nanomq.conf

# ---- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:9000"]

# ---- JWT ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- 身份认证 ----
# 服务端会话有效期，单位分钟；允许范围 5-1440，生产默认 8 小时。
AUTH_SESSION_MINUTES=480
# 生产登录必须经 HTTPS；关闭仅限完全隔离且不可被其他主机访问的开发环境。
AUTH_REQUIRE_HTTPS=true
# 默认不信任 X-Forwarded-Proto。仅在 TLS 反向代理场景中，且下方可信代理网段
# 非空时才可启用；来自其他地址的客户端即使伪造该请求头也不会被信任。
AUTH_TRUST_PROXY_HEADERS=false
# JSON CIDR 列表。示例：["127.0.0.1/32","::1/128"]；按实际代理地址最小化配置。
AUTH_TRUSTED_PROXY_CIDRS=[]

# ---- F0 管道性能参数 ---
PIPELINE_BATCH_SIZE=50
PIPELINE_FLUSH_INTERVAL_SEC=1.0
CE_AGGREGATION_INTERVAL_SEC=10.0

# ---- 前端构建参数 (仅 frontend Dockerfile 使用) ---
VITE_API_BASE_URL=http://localhost:9000
VITE_WS_URL=ws://localhost:9000

# ---- Uvicorn 启动参数 ---
# 开发时: UVICORN_EXTRA_ARGS=--reload
# 生产时: 留空 (或 --workers 2)
UVICORN_EXTRA_ARGS=
