# ============================================================
# ZiZu 2?? (holo3720) ARM64 ????
# v0.4.12 - ???? (zen-engine + ?? F1-F3 ??)
# ============================================================

FROM docker.m.daocloud.io/library/python:3.12-slim

LABEL maintainer="ZiZu Team"
LABEL description="ZiZu IoT Platform - holo3720 ARM64 Full Stack"
LABEL version="0.4.12"

WORKDIR /app

# ????
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# F0 ???? (??????)
RUN pip install --no-cache-dir \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        fastapi \
        "uvicorn[standard]" \
        psycopg2-binary \
        paho-mqtt \
        loguru \
        pydantic \
        pydantic-settings \
        pint \
        websockets

# F1-F3 ???? (????/????/??)
RUN pip install --no-cache-dir \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        zen-engine \
        httpx \
        tenacity \
        "apscheduler[asyncio,timezone]>=3.10.4" \
        "python-jose[cryptography]>=3.3.0" \
        "passlib[bcrypt]>=1.7.4" \
        python-multipart \
        "pyyaml>=6.0.2" \
        pandas \
        sympy

# ? root ?? (???? volume ?????? COPY)
RUN groupadd -r zizu && useradd -r -g zizu zizu && \
    chown -R zizu:zizu /app
USER zizu

EXPOSE 9000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9000/api/v1/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "9000", "--log-level", "info", "--no-proxy-headers"]
